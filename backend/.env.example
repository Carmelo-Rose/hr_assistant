# 后端环境变量示例 —— 复制为 .env 并按需填写

# Playwright 浏览器路径（CDP 抓取用，可选）
# PLAYWRIGHT_BROWSERS_PATH=...

# BOSS CDP 端口（可选，默认 9222）
# BOSS_CDP_URL=http://localhost:9222

# 服务对外访问地址：
# - 本机开发：保持 http://localhost:8000
# - 内网服务机：例如 http://192.168.1.20:8000
# - 内网穿透公网域名：例如 https://hr.example.com
# 后端会用它生成油猴脚本里的 @updateURL/@downloadURL 和 API 地址。
PUBLIC_BASE_URL=http://localhost:8000

# 额外允许的浏览器来源，多个用英文逗号分隔。通常 dashboard 由后端同源托管时无需设置。
# CORS_ORIGINS=http://192.168.1.20:8000,https://hr.example.com

# ── LLM 精评（国产大模型，OpenAI 兼容接口）────────────────────────────
# 任意支持 OpenAI /chat/completions 协议的模型都能接，填以下三项即可：
#
# DeepSeek:   LLM_BASE_URL=https://api.deepseek.com/v1        LLM_MODEL=deepseek-chat
# 通义千问:    LLM_BASE_URL=https://dashscope.aliyun.com/compatible-mode/v1   LLM_MODEL=qwen-plus
# 智谱 GLM:    LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4             LLM_MODEL=glm-4-flash
# Kimi:       LLM_BASE_URL=https://api.moonshot.cn/v1         LLM_MODEL=moonshot-v1-8k
#
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=
# LLM_TIMEOUT=60          # 单次请求超时秒数（可选）
# LLM_BATCH_SIZE=10       # 每次请求评多少人（可选）
